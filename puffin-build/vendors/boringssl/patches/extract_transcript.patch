diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
index 3a4b690..4263355 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -358,6 +358,99 @@ void SSL_set_aes_hw_override_for_testing(SSL *ssl, bool override_value) {

 BSSL_NAMESPACE_END

+// PUFFIN fuzzing framework: forward declarations
+void PUFFIN_store_ch_sh_transcript(const SSL *ssl, const uint8_t *hash,
+                                   size_t hash_len);
+void PUFFIN_store_handshake_secret(const SSL *ssl, const uint8_t *secret,
+                                   size_t secret_len);
+
+// PUFFIN fuzzing framework: CH+SH transcript storage (thread-local)
+static thread_local SSL *g_puffin_ch_sh_ssl = NULL;
+static thread_local uint8_t g_puffin_ch_sh_hash[64];
+static thread_local size_t g_puffin_ch_sh_hash_len = 0;
+
+// PUFFIN fuzzing framework: handshake secret storage (thread-local)
+static thread_local SSL *g_puffin_hs_secret_ssl = NULL;
+static thread_local uint8_t g_puffin_hs_secret[64];
+static thread_local size_t g_puffin_hs_secret_len = 0;
+
+void PUFFIN_store_ch_sh_transcript(const SSL *ssl, const uint8_t *hash,
+                                   size_t hash_len) {
+  if (ssl == NULL || hash == NULL || hash_len == 0 ||
+      hash_len > sizeof(g_puffin_ch_sh_hash)) {
+    return;
+  }
+  g_puffin_ch_sh_ssl = const_cast<SSL *>(ssl);
+  bssl::OPENSSL_memcpy(g_puffin_ch_sh_hash, hash, hash_len);
+  g_puffin_ch_sh_hash_len = hash_len;
+}
+
+void PUFFIN_store_handshake_secret(const SSL *ssl, const uint8_t *secret,
+                                   size_t secret_len) {
+  if (ssl == NULL || secret == NULL || secret_len == 0 ||
+      secret_len > sizeof(g_puffin_hs_secret)) {
+    return;
+  }
+  g_puffin_hs_secret_ssl = const_cast<SSL *>(ssl);
+  bssl::OPENSSL_memcpy(g_puffin_hs_secret, secret, secret_len);
+  g_puffin_hs_secret_len = secret_len;
+}
+
+int PUFFIN_extract_ch_sh_transcript(SSL *ssl, uint8_t *out, size_t *out_len) {
+  if (ssl == NULL || out == NULL || out_len == NULL) {
+    return 0;
+  }
+  if (g_puffin_ch_sh_ssl != ssl || g_puffin_ch_sh_hash_len == 0) {
+    return 0;
+  }
+  size_t to_copy =
+      *out_len < g_puffin_ch_sh_hash_len ? *out_len : g_puffin_ch_sh_hash_len;
+  bssl::OPENSSL_memcpy(out, g_puffin_ch_sh_hash, to_copy);
+  *out_len = to_copy;
+  return 1;
+}
+
+int PUFFIN_extract_handshake_secret(SSL *ssl, uint8_t *out, size_t *out_len) {
+  if (ssl == NULL || out == NULL || out_len == NULL) {
+    return 0;
+  }
+  if (g_puffin_hs_secret_ssl != ssl || g_puffin_hs_secret_len == 0) {
+    return 0;
+  }
+  size_t to_copy =
+      *out_len < g_puffin_hs_secret_len ? *out_len : g_puffin_hs_secret_len;
+  bssl::OPENSSL_memcpy(out, g_puffin_hs_secret, to_copy);
+  *out_len = to_copy;
+  return 1;
+}
+
+void PUFFIN_clear_ch_sh_transcript(SSL *ssl) {
+  if (ssl == NULL || g_puffin_ch_sh_ssl != ssl) {
+    return;
+  }
+  bssl::OPENSSL_memset(g_puffin_ch_sh_hash, 0, sizeof(g_puffin_ch_sh_hash));
+  g_puffin_ch_sh_hash_len = 0;
+  g_puffin_ch_sh_ssl = NULL;
+}
+
+void PUFFIN_clear_handshake_secret(SSL *ssl) {
+  if (ssl == NULL || g_puffin_hs_secret_ssl != ssl) {
+    return;
+  }
+  bssl::OPENSSL_memset(g_puffin_hs_secret, 0, sizeof(g_puffin_hs_secret));
+  g_puffin_hs_secret_len = 0;
+  g_puffin_hs_secret_ssl = NULL;
+}
+
+int PUFFIN_extract_transcript(SSL *ssl, uint8_t *out, size_t *out_len) {
+  bssl::SSL_HANDSHAKE *hs = ssl->s3->hs.get();
+  if (hs == NULL) {
+    return 0;
+  }
+  hs->transcript.GetHash(out, out_len);
+  return 1;
+}
+
 using namespace bssl;

 int SSL_library_init() { return 1; }
