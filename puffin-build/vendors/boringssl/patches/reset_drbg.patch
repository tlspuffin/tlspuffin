+  void *state = CRYPTO_get_thread_local(OPENSSL_THREAD_LOCAL_RAND);
+  if (state != nullptr) {
+    OPENSSL_free(state);
+    CRYPTO_set_thread_local(OPENSSL_THREAD_LOCAL_RAND, nullptr, nullptr);
+  }
+}

