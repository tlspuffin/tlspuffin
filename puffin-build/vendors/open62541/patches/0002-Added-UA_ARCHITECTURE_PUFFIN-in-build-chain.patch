+
+_UA_BEGIN_DECLS
+
+#include <errno.h>
+
+/*********************/
+/* POSIX Definitions */
+/*********************/
+
+/*---------------------*/
+/* Network Definitions */
+/*---------------------*/
+
+#include <sys/socket.h>
+#include <sys/select.h>
+#include <sys/ioctl.h>
+#include <arpa/inet.h>
+#include <netinet/in.h>
