 import netifaces
 import sys
@@ -99,6 +100,14 @@ if iteratorValue < 2:
     os.environ['IPADDRESS2'] = "127.0.0.1"
 
 os.environ['HOSTNAME'] = socket.gethostname()
+
+# /!\ OPCUA PUFFIN:
+os.environ['HOSTNAME'] = "localhost"
+os.environ['IPADDRESS1'] = "127.0.0.1"
+os.environ['IPADDRESS2'] = "127.0.0.1"
+os.environ['URI1'] = "opc.tcp://localhost:" + "4840/opcuapuffin." + certificatename
+Agent = "PuffinClientMallory"
+
 openssl_conf = os.path.join(certsdir, "localhost.cnf")
 
 os.chdir(os.path.abspath(args.outdir))
@@ -111,8 +120,8 @@ try:
         "-new", "-nodes", "-x509", "-sha256",
         "-newkey", f"rsa:{keysize}",
         "-keyout", "localhost.key",
-        "-days", "365",
-        "-subj", "/C=DE/L=Here/O=open62541/CN=open62541Server@localhost",
+        "-days", "1825",
+        "-subj", "/C=FR/L=Here/O=Inria/CN=Opcua" + Agent + "@localhost",
         "-out", "localhost.crt"
     ], check=True)
     
