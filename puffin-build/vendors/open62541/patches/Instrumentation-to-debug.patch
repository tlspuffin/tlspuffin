From 0284a2f4d1a0884b23b4970e32578cde7db71c6b Mon Sep 17 00:00:00 2001
From: vdh-anssi <vincent.diemunsch@inria.fr>
Date: Wed, 21 Jan 2026 17:02:18 +0100
Subject: [PATCH 2/2] Instrumentation for debug

---
 arch/posix/eventloop_posix_tcp.c | 19 ++++++++++-----
 src/client/ua_client_connect.c   |  3 ++-
 src/server/ua_server.c           | 41 +++++++++++++++++++++++++++++---
 3 files changed, 53 insertions(+), 10 deletions(-)

diff --git a/arch/posix/eventloop_posix_tcp.c b/arch/posix/eventloop_posix_tcp.c
index b0fb9b3df..1b3b6ef34 100644
--- a/arch/posix/eventloop_posix_tcp.c
+++ b/arch/posix/eventloop_posix_tcp.c
@@ -263,13 +263,12 @@ TCP_connectionSocketCallback(UA_ConnectionManager *cm, TCP_FD *conn,
         return;
     }
 
-    UA_LOG_DEBUG(el->eventLoop.logger, UA_LOGCATEGORY_NETWORK,
-                 "TCP %u\t| Allocate receive buffer",
-                 (unsigned)conn->rfd.fd);
-
     /* Use the already allocated receive-buffer */
     UA_POSIXConnectionManager *pcm = (UA_POSIXConnectionManager*)cm;
     UA_ByteString response = pcm->rxBuffer;
+    UA_LOG_DEBUG(el->eventLoop.logger, UA_LOGCATEGORY_NETWORK,
+        "TCP %u\t| Use already allocated receive buffer (%lu bytes at %p)",
+        (unsigned)conn->rfd.fd, pcm->rxBuffer.length, pcm->rxBuffer.data);
 
     /* Receive */
     UA_RESET_ERRNO;
@@ -625,8 +624,10 @@ TCP_registerListenSocket(UA_POSIXConnectionManager *pcm, struct addrinfo *ai,
            UA_LOG_WARNING(el->eventLoop.logger, UA_LOGCATEGORY_NETWORK,
                           "TCP %u\t| Error binding the socket to the address %s (%s)",
                           (unsigned)listenSocket, hostname, errno_str));
-        UA_close(listenSocket);
-        return UA_STATUSCODE_BADINTERNALERROR;
+        if (errno != 48) {
+            UA_close(listenSocket);
+            return UA_STATUSCODE_BADINTERNALERROR;
+        };
     }
 
     /* Only validate, don't actually start listening */
@@ -1162,6 +1163,8 @@ TCP_eventSourceStart(UA_ConnectionManager *cm) {
         return UA_STATUSCODE_BADINTERNALERROR;
 
     UA_LOCK(&el->elMutex);
+    UA_LOG_ERROR(el->eventLoop.logger, UA_LOGCATEGORY_NETWORK,
+        "TCP\t| EventSource starts");
 
     /* Check the state */
     if(cm->eventSource.state != UA_EVENTSOURCESTATE_STOPPED) {
@@ -1188,6 +1191,10 @@ TCP_eventSourceStart(UA_ConnectionManager *cm) {
     /* Set the EventSource to the started state */
     cm->eventSource.state = UA_EVENTSOURCESTATE_STARTED;
 
+    UA_LOG_DEBUG(el->eventLoop.logger, UA_LOGCATEGORY_NETWORK,
+        "TCP\t| EventSource is started and rxBuffer allocated (at: %p, of size: %u).",
+        (void*) pcm, (void*) pcm->rxBuffer.data, pcm->rxBuffer.length);
+
  finish:
     UA_UNLOCK(&el->elMutex);
     return res;
diff --git a/src/client/ua_client_connect.c b/src/client/ua_client_connect.c
index 9507d7317..043aed9a9 100644
--- a/src/client/ua_client_connect.c
+++ b/src/client/ua_client_connect.c
@@ -2029,7 +2029,8 @@ initConnect(UA_Client *client) {
         UA_parseEndpointUrl(&client->config.endpointUrl, &hostname, &port, &path);
     if(client->connectStatus != UA_STATUSCODE_GOOD) {
         UA_LOG_WARNING(client->config.logging, UA_LOGCATEGORY_NETWORK,
-                       "Endpoint URL is invalid: %S", client->config.endpointUrl);
+                       "Endpoint URL is invalid: %S (%s)", client->config.endpointUrl,
+                       UA_StatusCode_name(client->connectStatus) );
         return;
     }
 
diff --git a/src/server/ua_server.c b/src/server/ua_server.c
index 51c2e4bd3..f5788308c 100644
--- a/src/server/ua_server.c
+++ b/src/server/ua_server.c
@@ -411,7 +411,11 @@ stopServerComponent(void *_, UA_ServerComponent *sc) {
 /* ZIP_ITER returns NULL only if all components are stopped */
 static void *
 checkServerComponent(void *_, UA_ServerComponent *sc) {
-    return (sc->state == UA_LIFECYCLESTATE_STOPPED) ? NULL : (void*)0x01;
+    if (sc->state == UA_LIFECYCLESTATE_STOPPED) {
+        return NULL;
+    } else {
+        return (void*) &sc->name;
+    }
 }
 
 /********************/
@@ -466,7 +470,11 @@ UA_Server_delete(UA_Server *server) {
     /* Remove all server components (all stopped by now) */
     UA_ServerComponent *top;
     while((top = ZIP_ROOT(&server->serverComponents))) {
-        UA_assert(top->state == UA_LIFECYCLESTATE_STOPPED);
+        //UA_assert(top->state == UA_LIFECYCLESTATE_STOPPED);
+        if (top->state != UA_LIFECYCLESTATE_STOPPED) {
+            UA_LOG_ERROR(server->config.logging, UA_LOGCATEGORY_SERVER,
+                "Assertion `top->state == UA_LIFECYCLESTATE_STOPPED' failed.");
+        }
         top->clear(top);
         ZIP_REMOVE(UA_ServerComponentTree, &server->serverComponents, top);
         UA_free(top);
@@ -1364,6 +1372,8 @@ UA_StatusCode
 UA_Server_run_shutdown(UA_Server *server) {
     if(server == NULL)
         return UA_STATUSCODE_BADINVALIDARGUMENT;
+    UA_LOG_DEBUG(server->config.logging, UA_LOGCATEGORY_SERVER,
+        "The server is shutting down...");
 
     lockServer(server);
 
@@ -1376,6 +1386,8 @@ UA_Server_run_shutdown(UA_Server *server) {
 
     /* Set to stopping and notify the application */
     setServerLifecycleState(server, UA_LIFECYCLESTATE_STOPPING);
+    UA_LOG_DEBUG(server->config.logging, UA_LOGCATEGORY_SERVER,
+        "The server is set to STOPPING");
 
 #if UA_MULTITHREADING >= 100
     /* Stop regular callback for async operation processing */
@@ -1387,14 +1399,21 @@ UA_Server_run_shutdown(UA_Server *server) {
         removeCallback(server, server->houseKeepingCallbackId);
         server->houseKeepingCallbackId = 0;
     }
+    UA_LOG_DEBUG(server->config.logging, UA_LOGCATEGORY_NETWORK,
+        "The server housekeeping tasks: remove callbacks done");
 
     /* Stop all ServerComponents */
+    UA_LOG_DEBUG(server->config.logging, UA_LOGCATEGORY_SERVER,
+        "Stop server components...");
     ZIP_ITER(UA_ServerComponentTree, &server->serverComponents,
              stopServerComponent, NULL);
 
     /* Are we already stopped? */
     if(testStoppedCondition(server)) {
         setServerLifecycleState(server, UA_LIFECYCLESTATE_STOPPED);
+        UA_LOG_DEBUG(server->config.logging, UA_LOGCATEGORY_SERVER,
+            "The server is already STOPPED");
+
     }
 
     /* Only stop the EventLoop if it is coupled to the server lifecycle  */
@@ -1406,18 +1425,34 @@ UA_Server_run_shutdown(UA_Server *server) {
     /* Unlock and do one "normal" iteration. This allows threads waiting for the
      * server lock to proceed before the server lock is destroyed. */
     unlockServer(server);
+    UA_LOG_DEBUG(server->config.logging, UA_LOGCATEGORY_SERVER,
+        "Server: A last normal iteration");
     UA_Server_run_iterate(server, true);
     lockServer(server);
 
     /* Iterate the EventLoop until the server is stopped */
+    UA_LOG_DEBUG(server->config.logging, UA_LOGCATEGORY_SERVER,
+        "Iterate the EventLoop until the server is stopped");
     UA_StatusCode res = UA_STATUSCODE_GOOD;
     UA_EventLoop *el = server->config.eventLoop;
+    int i = 0;
     while(!testStoppedCondition(server) &&
-          res == UA_STATUSCODE_GOOD) {
+          res == UA_STATUSCODE_GOOD && i < 10) {
         res = el->run(el, 100);
+        i++;
+    }
+    if (i == 10) {
+        UA_String *name = (UA_String *) ZIP_ITER(UA_ServerComponentTree,
+            &server->serverComponents, checkServerComponent, NULL);
+        UA_LOG_ERROR(server->config.logging, UA_LOGCATEGORY_SERVER,
+            "Server components are not all stopped after 10 iterations");
+        UA_LOG_ERROR(server->config.logging, UA_LOGCATEGORY_SERVER,
+            "Server component: %S", *name);
     }
 
     /* Stop the EventLoop. Iterate until stopped. */
+    UA_LOG_DEBUG(server->config.logging, UA_LOGCATEGORY_SERVER,
+        "Stopping the EventLoop: iterate until stopped.");
     el->stop(el);
     while(el->state != UA_EVENTLOOPSTATE_STOPPED &&
           el->state != UA_EVENTLOOPSTATE_FRESH &&
-- 
2.51.0

