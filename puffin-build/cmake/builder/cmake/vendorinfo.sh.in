#!/usr/bin/env bash

set -euo pipefail

function to_toml_array() {
    declare -a array=( "$@" )

    if (( ${#array[@]} == 0 )); then
        printf "[]\n"
        return 0
    fi

    array=( $(printf '"%s"\n' "${array[@]}" ) )
    array=$(IFS=','; printf '%s\n' "${array[*]+"${array[*]}"}")
    printf "[%s]\n" "${array}"
}

LIBNAME=@VENDOR_LIBNAME@
VERSION=@VENDOR_VERSION@
KNOWN_VULNERABILITIES=( @KNOWN_VULNERABILITIES@ )
FIXED_VULNERABILITIES=( @FIXED_VULNERABILITIES@ )

if [ -z ${INSTALL_DIR+x} ]; then
    INSTALL_DIR=$( cd -P "$( dirname -- "${BASH_SOURCE[0]}" )/.." &> /dev/null && pwd )
fi

if [ -z ${NM+x} ]; then
    NM="nm"
fi

declare -a CAPABILITIES=(
    $<$<BOOL:@tls12@>:tls12>
    $<$<BOOL:@tls13@>:tls13>
    $<$<BOOL:@tls12_session_resumption@>:tls12_session_resumption>
    $<$<BOOL:@tls13_session_resumption@>:tls13_session_resumption>
    $<$<BOOL:@allow_setting_tls12_ciphers@>:allow_setting_tls12_ciphers>
    $<$<BOOL:@allow_setting_tls13_ciphers@>:allow_setting_tls13_ciphers>
    $<$<BOOL:@transcript_extraction@>:transcript_extraction>
    $<$<BOOL:@client_authentication_transcript_extraction@>:client_authentication_transcript_extraction>
    $<$<BOOL:@disable_postauth@>:disable_postauth>
    $<$<BOOL:@psk_ke_support@>:psk_ke_support>
)

declare -a INSTRUMENTATION=(
    $<$<BOOL:@sancov@>:sancov>
    $<$<BOOL:@asan@>:asan>
    $<$<BOOL:@gcov@>:gcov>
    $<$<BOOL:@llvm_cov@>:llvm_cov>
)

function header_define() { # <header> <macro>: the macro's string/number value
    [ -f "$1" ] || return 0
    sed -n -E "s/^#[[:space:]]*define[[:space:]]+$2[[:space:]]+\"?([^\"]*)\"?.*$/\1/p" "$1" | head -1
}

# What depends on the vendor lives next to its builder, in
# puffin-build/vendors/<vendor>/vendorinfo.sh, sourced here if it exists. It may set:
#   CLAIM_SYMBOLS      symbols whose presence in the installed archives means the library is
#                      instrumented for claims (e.g. `register_claimer` of tlspuffin-claims);
#   detected_version   a function printing the version found in the installed headers
#                      (`header_define` above helps reading a header macro).
CLAIM_SYMBOLS=()
function detected_version() { :; }
VENDOR_INFO_FRAGMENT="@VENDOR_INFO_FRAGMENT@"
if [ -n "${VENDOR_INFO_FRAGMENT}" ] && [ -f "${VENDOR_INFO_FRAGMENT}" ]; then
    # shellcheck source=/dev/null
    source "${VENDOR_INFO_FRAGMENT}"
fi

if (( ${#CLAIM_SYMBOLS[@]} )) && "${NM}" "${INSTALL_DIR}"/lib/*.a 2>/dev/null \
        | grep -E "$(IFS='|'; printf '%s' "${CLAIM_SYMBOLS[*]}")" >/dev/null; then
    INSTRUMENTATION+=("claimer")
fi

# Surface the version actually found in the installed headers, and warn (stderr,
# i.e. the vendor build log — stdout is the .metadata file) when it disagrees with
# the preset's declared `version`: e.g. a moving `branch` that advanced, or a
# preset edited without rebuilding. Libraries without a version probe (BoringSSL)
# and non-numeric preset versions (main/master) are only reported, not checked.
DETECTED_VERSION=$(detected_version 2>/dev/null || true)
EXPECTED_VERSION="${VERSION%%+*}" # drop build metadata, e.g. 1.1.1g+git.<sha>
if [ -z "${DETECTED_VERSION}" ]; then
    echo "vendorinfo: ${LIBNAME}: preset version ${VERSION}; no version found in the installed headers" >&2
elif [[ "${EXPECTED_VERSION}" =~ ^[0-9] ]] && [ "${DETECTED_VERSION}" != "${EXPECTED_VERSION}" ]; then
    echo "vendorinfo: WARNING: ${LIBNAME}: preset declares version ${VERSION} but the installed headers say ${DETECTED_VERSION} (stale vendor or moving branch?)" >&2
else
    echo "vendorinfo: ${LIBNAME}: version ${DETECTED_VERSION} (preset ${VERSION})" >&2
fi

cat <<EOF
vendor = "${LIBNAME}"
version = "${VERSION}"
instrumentation = $(to_toml_array "${INSTRUMENTATION[@]}")
known_vulnerabilities = $(to_toml_array ${KNOWN_VULNERABILITIES[@]})
fixed_vulnerabilities = $(to_toml_array ${FIXED_VULNERABILITIES[@]})
capabilities = $(to_toml_array ${CAPABILITIES[@]})
EOF
